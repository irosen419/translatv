# The web client as a static site behind nginx. An EXAMPLE: replace api.example.com with your
# API's hostname, app.example.com with the site's, and the root with wherever the built
# client/dist was copied (DEPLOY.md, "Two services"). TLS is left to whatever already terminates it.
#
# Same headers as _headers.example in this directory; the CSP must stay identical to that file's
# (script/static_server.test.mjs compares them).

server {
    listen 80;
    server_name app.example.com;
    root /srv/translatv-client;
    index index.html;

    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' https://api.example.com wss://api.example.com; media-src 'self' blob:; img-src 'self' blob: data:; font-src 'self'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'; form-action 'none'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "microphone=(self), camera=(self), geolocation=(), payment=(), usb=()" always;

    # Hashed file names, so a year is safe. A missing asset is a 404, never index.html: an HTML
    # page served as JavaScript fails far from the cause.
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' https://api.example.com wss://api.example.com; media-src 'self' blob:; img-src 'self' blob: data:; font-src 'self'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'; form-action 'none'" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    # SPA fallback: /r/<code> and every other client route get index.html with a 200, so a shared
    # room link works as a first navigation.
    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' https://api.example.com wss://api.example.com; media-src 'self' blob:; img-src 'self' blob: data:; font-src 'self'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'; form-action 'none'" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Permissions-Policy "microphone=(self), camera=(self), geolocation=(), payment=(), usb=()" always;
    }
}
