# Copy to .env and fill in. .env is gitignored and must never be committed.

# Anthropic API key for translation. Server side only.
# NEVER rename this with a VITE_ prefix: Vite inlines every VITE_* variable into the
# client bundle, which would ship the key to every visitor.
ANTHROPIC_API_KEY=

# HTTP port the server listens on.
PORT=8080

# Comma separated list of allowed origins for the WebSocket upgrade check.
# This is the CSRF equivalent for a cookie-less WebSocket app.
ORIGIN=http://localhost:5173,http://localhost:8080

# The key every sign in token is signed with. Required in production: the server REFUSES TO
# START without it, because a guessable key lets anyone mint a session for any account and a
# random one per boot signs everyone out on every restart. Generate it, never type it:
#   openssl rand -hex 32
# Left empty here on purpose, so this file never carries a credential shaped value. In
# development an empty value means a random key per process (and a warning saying so).
AUTH_SECRET=

# Who may create an account: "invite" (the default) or "open". Invite only by default because the
# daily spend cap is shared, so open signup lets a stranger spend the owner's money down to it.
SIGNUP_MODE=

# The account with this email is the owner, who can mint invites from the app. The very first
# invite on a fresh server comes from `npm run invite` (or, in the container,
# `node server/dist/cli/invite.js`), since nobody is signed in yet to ask for one.
OWNER_EMAIL=

# Which interface docker-compose publishes port 8080 on. Loopback by default, because the
# documented deploy puts a Cloudflare Tunnel in front and the tunnel reaches the container over
# loopback. A public bind behind a tunnel lets someone reach the port directly and, with
# TRUST_PROXY=1 on, forge X-Forwarded-For past every per IP limit.
# Set 0.0.0.0 only for a LAN test on a network you trust.
BIND_ADDR=

# Spend caps. Checked against the ledger before every API call, never against an in memory
# counter, so a restart cannot reset the day's spend to zero.
# Global daily ceiling. On breach, translation degrades to original text only and the app
# keeps working.
ANTHROPIC_DAILY_CAP_USD=10.00
# Per room ceiling. 1.50 is roughly three hours of continuous conversation.
ROOM_CAP_USD=1.50
# Per account ceiling per UTC day, charged to the room's host (the account that created it),
# whoever is speaking. A call is translated only when all three caps pass, so this can only
# tighten the two above, never loosen them.
USER_DAILY_CAP_USD=1.00

# TURN relay. Without one, WebRTC peer to peer fails for roughly 10 to 15 percent of network
# pairs (symmetric NAT, corporate firewalls). Transcripts still work over the WebSocket in
# that case, so the call degrades to text only rather than failing outright.
#
# ALL THREE or none. The server refuses to start on a partial set, naming what is missing. A URL
# with no credentials produces an ICE entry the browser accepts and cannot use, because every
# TURN server rejects an uncredentialed relay allocation, so it looks configured and carries no
# calls. Whitespace does not count as set.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# Trust the nearest (rightmost) hop of X-Forwarded-For for the client address. Set this ONLY
# when a reverse proxy is genuinely in front. Production alone does not imply one, and trusting
# the header with nothing behind it lets an attacker set a fresh value per request and walk past
# every per IP limit, including the join limiter that is the only real defense on room codes.
TRUST_PROXY=

# Allow the spend ledger to live on the image layer instead of a mounted volume. Off by default:
# an ephemeral ledger resets the day's observed spend on every restart, which re arms a cap that
# is meant to be cumulative. Only set this on a host that genuinely keeps out/ on the root device.
ALLOW_EPHEMERAL_LEDGER=

# Directory holding the SQLite database, translatv.db. Relative paths resolve against the repo
# root. Defaults to data/ under the repo root, which is gitignored.
DATA_DIR=

# Allow the database to live on the image layer instead of a mounted volume. Off by default: a
# database on the image layer is deleted by every redeploy, taking every account with it. Only set
# this on a host that genuinely keeps DATA_DIR on the root device.
ALLOW_EPHEMERAL_DATA=
